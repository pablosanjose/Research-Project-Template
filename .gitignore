data/*
!data/.gitkeep

# Generated output (folders kept with .gitkeep)
simulations/out/*
!simulations/out/.gitkeep
analysis/output/*
!analysis/output/.gitkeep

# Personal, never shared
sync-data.local.conf
CLAUDE.local.md
.claude/CLAUDE.local.md
.claude/settings.local.json
.DS_Store
